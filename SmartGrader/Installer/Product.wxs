            </Component>
            <Component Id="MicrosoftDataSqlite" Guid="*">
                <File Id="MicrosoftDataSqlite.dll" Source="/workspace/SmartGrader/publish/Microsoft.Data.Sqlite.dll"/>
            </Component>
            <Component Id="EFCore" Guid="*">
                <File Id="Microsoft.EntityFrameworkCore.dll" Source="/workspace/SmartGrader/publish/Microsoft.EntityFrameworkCore.dll"/>
            </Component>
            <Component Id="EFCoreAbstractions" Guid="*">
                <File Id="Microsoft.EntityFrameworkCore.Abstractions.dll" Source="/workspace/SmartGrader/publish/Microsoft.EntityFrameworkCore.Abstractions.dll"/>
            </Component>
            <Component Id="EFCoreRelational" Guid="*">
