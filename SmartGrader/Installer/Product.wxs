            </Component>
            <Component Id="ExtensionsDep" Guid="*">
                <File Id="Microsoft.Extensions.DependencyInjection.dll" Source="/workspace/SmartGrader/publish/Microsoft.Extensions.DependencyInjection.dll"/>
            </Component>
            <Component Id="ExtensionsDepAbstractions" Guid="*">
                <File Id="Microsoft.Extensions.DependencyInjection.Abstractions.dll" Source="/workspace/SmartGrader/publish/Microsoft.Extensions.DependencyInjection.Abstractions.dll"/>
            </Component>
            <Component Id="ExtensionsLogging" Guid="*">
                <File Id="Microsoft.Extensions.Logging.dll" Source="/workspace/SmartGrader/publish/Microsoft.Extensions.Logging.dll"/>
            </Component>
            <Component Id="ExtensionsLoggingAbstractions" Guid="*">
                <File Id="Microsoft.Extensions.Logging.Abstractions.dll" Source="/workspace/SmartGrader/publish/Microsoft.Extensions.Logging.Abstractions.dll"/>
            </Component>
            <Component Id="ExtensionsOptions" Guid="*">
                <File Id="Microsoft.Extensions.Options.dll" Source="/workspace/SmartGrader/publish/Microsoft.Extensions.Options.dll"/>
            </Component>
            <Component Id="Prism" Guid="*">
                <File Id="Prism.dll" Source="/workspace/SmartGrader/publish/Prism.dll"/>
            </Component>
