            <Component Id="StartMenuShortcut" Guid="*">
                <Shortcut Id="StartMenuShortcut" Name="智能作业批阅平台" Directory="StartMenuFolder" Target="[INSTALLFOLDER]SmartGrader.exe" WorkingDirectory="INSTALLFOLDER"/>
                <RegistryValue Root="HKCU" Key="Software\SmartGrader" Name="StartMenuShortcut" Type="integer" Value="1"/>
            </Component>
