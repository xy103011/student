<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SmartGrader</AssemblyName>
    <RootNamespace>SmartGrader</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartGrader.Core\SmartGrader.Core.csproj" />
    <ProjectReference Include="..\SmartGrader.Data\SmartGrader.Data.csproj" />
    <ProjectReference Include="..\SmartGrader.AI\SmartGrader.AI.csproj" />
    <ProjectReference Include="..\SmartGrader.Image\SmartGrader.Image.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\AssignmentsView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\GradingView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\StudentsView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\StatisticsView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\ClassStatsView.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\SettingsView.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
