<Window x:Class="SmartGrader.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartGrader.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="智能作业批阅平台" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#4472C4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 侧边导航栏 -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="智能作业批阅平台" 
                           FontSize="18" FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,30"/>
                
                <Button Content="作业管理" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Assignments"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="批阅作业" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Grading"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="学生管理" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Students"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="成绩统计" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Statistics"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="系统设置" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Settings"
                        Style="{StaticResource NavButtonStyle}"/>
            </StackPanel>
        </Border>
        
        <!-- 主内容区域 -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding CurrentView}" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>
            
            <!-- 内容区域 -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            
            <!-- 状态栏 -->
            <TextBlock Grid.Row="2" 
                       Text="{Binding StatusMessage}" 
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
