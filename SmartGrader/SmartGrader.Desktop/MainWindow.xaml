<Window x:Class="SmartGrader.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartGrader.Desktop.ViewModels"
        xmlns:views="clr-namespace:SmartGrader.Desktop.Views"
        mc:Ignorable="d"
        Title="智能作业批阅平台" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4472C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <DataTemplate x:Key="AssignmentsTemplate">
            <views:AssignmentsView/>
        </DataTemplate>
        <DataTemplate x:Key="GradingTemplate">
            <views:GradingView/>
        </DataTemplate>
        <DataTemplate x:Key="StudentsTemplate">
            <views:StudentsView/>
        </DataTemplate>
        <DataTemplate x:Key="StatisticsTemplate">
            <views:StatisticsView/>
        </DataTemplate>
        <DataTemplate x:Key="ClassStatsTemplate">
            <views:ClassStatsView/>
        </DataTemplate>
        <DataTemplate x:Key="SettingsTemplate">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 侧边导航栏 -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="智能作业批阅平台" 
                           FontSize="18" FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,30"/>
                
                <Button Content="作业管理" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Assignments"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="批阅作业" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Grading"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="学生管理" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Students"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="成绩统计" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Statistics"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="班级统计" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="ClassStats"
                        Style="{StaticResource NavButtonStyle}"/>
                <Button Content="系统设置" 
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Settings"
                        Style="{StaticResource NavButtonStyle}"/>
            </StackPanel>
        </Border>
        
        <!-- 主内容区域 -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding CurrentView}" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>
            
            <!-- 内容区域 -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="Assignments">
                        <views:AssignmentsView/>
                    </DataTemplate>
                    <DataTemplate x:Key="Grading">
                        <views:GradingView/>
                    </DataTemplate>
                    <DataTemplate x:Key="Students">
                        <views:StudentsView/>
                    </DataTemplate>
                    <DataTemplate x:Key="Statistics">
                        <views:StatisticsView/>
                    </DataTemplate>
                    <DataTemplate x:Key="ClassStats">
                        <views:ClassStatsView/>
                    </DataTemplate>
                    <DataTemplate x:Key="Settings">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
            
            <!-- 状态栏 -->
            <TextBlock Grid.Row="2" 
                       Text="{Binding StatusMessage}" 
                       FontSize="12"
                       Foreground="Gray"
                       Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
