<UserControl x:Class="SmartGrader.Desktop.Views.ClassStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 选择区域 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="选择班级:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="ClassCombo" Width="200" Margin="0,0,10,0"/>
            
            <TextBlock Text="选择作业:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="AssignmentCombo" Width="200" Margin="0,0,10,0"/>
            
            <Button Content="查看统计" 
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
        
        <!-- 统计结果 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 成绩分布 -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <StackPanel>
                    <TextBlock Text="班级成绩" FontWeight="Bold" Margin="10"/>
                    <TextBlock Text="平均分" Margin="10,5"/>
                    <TextBlock Text="0" Margin="10,0"/>
                    <TextBlock Text="最高分" Margin="10,5"/>
                    <TextBlock Text="0" Margin="10,0"/>
                    <TextBlock Text="最低分" Margin="10,5"/>
                    <TextBlock Text="0" Margin="10,0"/>
                    <TextBlock Text="及格率" Margin="10,5"/>
                    <TextBlock Text="0%" Margin="10,0"/>
                </StackPanel>
            </Border>
            
            <!-- 人数统计 -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <StackPanel>
                    <TextBlock Text="人数统计" FontWeight="Bold" Margin="10"/>
                    <TextBlock Text="总人数" Margin="10,5"/>
                    <TextBlock Text="0" Margin="10,0"/>
                    <TextBlock Text="及格人数" Margin="10,5"/>
                    <TextBlock Text="0" Margin="10,0"/>
                    <TextBlock Text="不及格人数" Margin="10,5"/>
                    <TextBlock Text="0" Margin="10,0"/>
                </StackPanel>
            </Border>
            
            <!-- 成绩趋势 -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <StackPanel>
                    <TextBlock Text="成绩趋势" FontWeight="Bold" Margin="10"/>
                    <TextBlock Text="暂无数据" Margin="10" Foreground="Gray"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
