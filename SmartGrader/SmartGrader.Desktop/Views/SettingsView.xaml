<UserControl x:Class="SmartGrader.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 设置选项 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="AI服务配置" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="API Key:" Width="100" VerticalAlignment="Center"/>
                <TextBox Width="300" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Base URI:" Width="100" VerticalAlignment="Center"/>
                <TextBox Width="300" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="模型:" Width="100" VerticalAlignment="Center"/>
                <ComboBox Width="150">
                    <ComboBoxItem Content="GPT-4"/>
                    <ComboBoxItem Content="GPT-3.5 Turbo"/>
                    <ComboBoxItem Content="Claude"/>
                </ComboBox>
            </StackPanel>
            
            <Button Content="保存配置" 
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,10,0,20"/>
        </StackPanel>
        
        <!-- 数据库管理 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="数据库管理" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="备份数据库" 
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="恢复数据库" 
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="清空数据" 
                        Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
