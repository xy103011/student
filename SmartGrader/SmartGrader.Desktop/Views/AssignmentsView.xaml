<UserControl x:Class="SmartGrader.Desktop.Views.AssignmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SmartGrader.Desktop.ViewModels">
    <UserControl.Resources>
        <vm:MainViewModel x:Key="ViewModel"/>
    </UserControl.Resources>
    
    <Grid DataContext="{StaticResource ViewModel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="加载作业" 
                    Command="{Binding LoadAssignmentsCommand}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="新建作业" 
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="导入作业" 
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="导出作业" 
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
        
        <!-- 作业列表 -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Assignments}"
                  SelectedItem="{Binding SelectedAssignment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="作业名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="截止时间" Binding="{Binding Deadline, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
